# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database — local Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=forma

# Database — Supabase (overrides DB_* when set)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_SSL=true

# AI coach (optional): none | anthropic
AI_PROVIDER=none
# AI_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
